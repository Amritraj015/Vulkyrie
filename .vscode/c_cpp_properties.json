{
    "configurations": [
        {
            "name": "Win32",
            "compileCommands": [
                "${workspaceFolder}/compile_commands.json"
            ],
            "compilerArgs": [
                "/W4",
                "/WX"
            ]
        },
        {
            "name": "Linux",
            "compilerArgs": [
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-Werror"
            ],
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "compileCommands": [
                "${workspaceFolder}/compile_commands.json"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c23",
            "cppStandard": "c++23",
            "intelliSenseMode": "${default}",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "enableConfigurationSquiggles": true,
    "version": 4
}