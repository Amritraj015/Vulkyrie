{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-release",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VE_LOG_LEVEL": "1"
      }
    },
    {
      "name": "base-debug",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VE_LOG_LEVEL": "5"
      }
    },
    {
      "name": "toolchain-gcc",
      "hidden": true,
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "toolchain-gcc-win",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic"
      }
    },
    {
      "name": "toolchain-clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "toolchain-msvc",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "target-all",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "tests",
        "VULKYRIE_BUILD_EXAMPLES": "ON",
        "VULKYRIE_BUILD_EDITOR": "ON",
        "VULKYRIE_BUILD_CLI": "ON",
        "VULKYRIE_BUILD_TESTS": "ON",
        "VULKYRIE_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "target-examples",
      "hidden": true,
      "cacheVariables": {
        "VULKYRIE_BUILD_EXAMPLES": "ON",
        "VULKYRIE_BUILD_CLI": "OFF",
        "VULKYRIE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "target-cli",
      "hidden": true,
      "cacheVariables": {
        "VULKYRIE_BUILD_EXAMPLES": "OFF",
        "VULKYRIE_BUILD_CLI": "ON",
        "VULKYRIE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "target-tests",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "tests",
        "VULKYRIE_BUILD_EXAMPLES": "OFF",
        "VULKYRIE_BUILD_CLI": "OFF",
        "VULKYRIE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "target-benchmarks",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "tests",
        "VULKYRIE_BUILD_EXAMPLES": "OFF",
        "VULKYRIE_BUILD_EDITOR": "OFF",
        "VULKYRIE_BUILD_CLI": "OFF",
        "VULKYRIE_BUILD_TESTS": "OFF",
        "VULKYRIE_BUILD_BENCHMARKS": "ON"
      }
    },
